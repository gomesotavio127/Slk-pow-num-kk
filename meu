local function RenderScripts(jogo)
    for _, ch in ipairs(scriptScroll:GetChildren()) do
        if not ch:IsA("UIListLayout") then ch:Destroy() end
    end
    local filtro = Estado.busca:lower()
    local ordem = 0
    for _, sc in ipairs(jogo.scripts) do
        if filtro == "" or sc.nome:lower():find(filtro, 1, true) or (sc.desc and sc.desc:lower():find(filtro, 1, true)) then
            ordem = ordem + 1
            if sc.isApexHard then
                local box = Inst("Frame", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, LayoutOrder = ordem
                }, scriptScroll)
                Lista(box, SP.sm)
                local apexVersion = "None"
                local updating = false
                local tFree, tPrem

                local function Atualizar(v, sync)
                    if updating then return end
                    updating = true
                    apexVersion = v
                    if sync then
                        if v == "Free" and tPrem then tPrem.SetValue(false, false) end
                        if v == "Premium" and tFree then tFree.SetValue(false, false) end
                    end
                    updating = false
                end

                tFree = CriarToggle(box, "Versão Free", nil, false, function(state)
                    if state then
                        Atualizar("Free", true)
                    elseif apexVersion == "Free" and not updating then
                        Atualizar("None", false)
                    end
                end)
                tPrem = CriarToggle(box, "Versão Premium", nil, false, function(state)
                    if state then
                        Atualizar("Premium", true)
                    elseif apexVersion == "Premium" and not updating then
                        Atualizar("None", false)
                    end
                end)

                RegistrarElemento("ApexFree",
                    function() return apexVersion == "Free" end,
                    function(val)
                        if val then
                            Atualizar("Free", true)
                            tFree.SetValue(true, false)
                        else
                            if apexVersion == "Free" then Atualizar("None", false) end
                            tFree.SetValue(false, false)
                        end
                    end)
                RegistrarElemento("ApexPremium",
                    function() return apexVersion == "Premium" end,
                    function(val)
                        if val then
                            Atualizar("Premium", true)
                            tPrem.SetValue(true, false)
                        else
                            if apexVersion == "Premium" then Atualizar("None", false) end
                            tPrem.SetValue(false, false)
                        end
                    end)

                CriarBotao(box, "Executar Script", sc.desc, function()
                    local alvo
                    if apexVersion == "Premium" then
                        alvo = { nome = sc.nome, desc = sc.desc, url = sc.urlPremium }
                    else
                        alvo = { nome = sc.nome, desc = sc.desc, url = sc.urlFree }
                    end
                    ExecutarScript(alvo, jogo.nome)
                end)
            else
                local b = CriarBotao(scriptScroll, sc.nome, sc.desc, function()
                    ExecutarScript(sc, jogo.nome)
                end)
                b.LayoutOrder = ordem
            end
        end
    end
    Log("RenderScripts -> jogo:", jogo.nome, "| scripts:", #jogo.scripts)
end

