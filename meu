-- SECAO 1: SESSAO
local ActiveConnections = {}
local ActiveThreads = {}

local function RegistrarConexao(conn)
    if conn then table.insert(ActiveConnections, conn) end
end

local function RemoverConexao(conn)
    if not conn then return end
    for i = #ActiveConnections, 1, -1 do
        if ActiveConnections[i] == conn then table.remove(ActiveConnections, i) end
    end
end

local function RegistrarThread(thread)
    if thread then table.insert(ActiveThreads, thread) end
end

if env.CapivaraHubSession then
    pcall(function()
        if type(env.CapivaraHubSession.CleanUp) == "function" then env.CapivaraHubSession.CleanUp() end
    end)
    env.CapivaraHubSession = nil
end

local function LimparSessao()
    env.CapivaraHubActive = false
    for _, conn in ipairs(ActiveConnections) do
        pcall(function() if conn and typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end end)
    end
    ActiveConnections = {}
    for _, thread in ipairs(ActiveThreads) do
        pcall(function() task.cancel(thread) end)
    end
    ActiveThreads = {}
    if env.CapivaraToolConns then
        for _, conn in pairs(env.CapivaraToolConns) do
            pcall(function() if conn and typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end end)
        end
        env.CapivaraToolConns = {}
    end
    if env.CapivaraHubWindow then
        pcall(function() env.CapivaraHubWindow:Destroy() end)
        env.CapivaraHubWindow = nil
    end
end

env.CapivaraHubSession = { CleanUp = LimparSessao }
