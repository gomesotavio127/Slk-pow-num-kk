MostrarTela = function(id)
    if not Telas[id] then return end
    Estado.tela = id
    for tid, t in pairs(Telas) do
        if tid == id then
            t.frame.Visible = true
            t.frame.Position = UDim2.new(0, 0, 0, 8)
            Tween(t.frame, EASE, { Position = UDim2.new(0, 0, 0, 0) })
        else
            t.frame.Visible = false
        end
    end
    TituloTela.Text = Telas[id].titulo
    Busca.Visible = Telas[id].mostraBusca and true or false
    Busca.Text = ""
    Estado.busca = ""
    AtualizarNav()
    if id == "Jogos" then
        Estado.jogoSelecionado = nil
        if MostrarListaJogos then MostrarListaJogos() end
    end
end

