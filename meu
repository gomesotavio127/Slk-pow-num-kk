-- SECAO 4: HELPERS
local function Inst(cls, props, parent)
    local o = Instance.new(cls)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function Tween(o, t, props)
    local tw = TweenService:Create(o, t, props)
    tw:Play()
    return tw
end

local function Corner(o, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = o
    return c
end

local function Stroke(o, color)
    local s = Instance.new("UIStroke")
    s.Color = color or C.border
    s.Thickness = 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = o
    return s
end

local function Pad(o, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingTop = UDim.new(0, t or l or 0)
    p.PaddingRight = UDim.new(0, r or l or 0)
    p.PaddingBottom = UDim.new(0, b or t or l or 0)
    p.Parent = o
    return p
end

local function Lista(o, gap, dir)
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, gap or SP.sm)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.Parent = o
    return l
end

local function LigarCanvas(scroll, layout, extra)
    local function atualizar()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + (extra or SP.sm))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(atualizar)
