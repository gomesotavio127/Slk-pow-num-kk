local function CriarTela(id, titulo, mostraBusca)
    local f = Inst("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, Body)
    Telas[id] = { frame = f, titulo = titulo, mostraBusca = mostraBusca }
