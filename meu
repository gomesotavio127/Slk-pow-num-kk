-- SECAO 9: CONFIGURACAO (logica preservada)
local BASE_FOLDER = "CapivaraHub"
local CONFIG_FOLDER = BASE_FOLDER .. "/Save config"
local ARQ_AUTOLOAD = CONFIG_FOLDER .. "/_autoload.json"
local RegisteredElements = {}

local function GarantirPastas()
    if isfolder and makefolder then
        if not isfolder(BASE_FOLDER) then pcall(makefolder, BASE_FOLDER) end
        if not isfolder(CONFIG_FOLDER) then pcall(makefolder, CONFIG_FOLDER) end
    end
end
GarantirPastas()

local function ListarConfigsSalvas()
    GarantirPastas()
    local lista = {}
    if listfiles and isfolder and isfolder(CONFIG_FOLDER) then
        local ok, arquivos = pcall(listfiles, CONFIG_FOLDER)
        if ok and type(arquivos) == "table" then
            for _, caminho in ipairs(arquivos) do
                if caminho:sub(-5) == ".json" and not caminho:find("_autoload.json") then
                    local nome = caminho:match("([^/\\]+)%.json$")
                    if nome then table.insert(lista, nome) end
                end
            end
        end
    end
    if #lista == 0 then table.insert(lista, "Nenhuma") end
    table.sort(lista)
    return lista
end

local function RegistrarElemento(flag, get, set)
    RegisteredElements[flag] = { get = get, set = set }
end

local function SaveConfig(configName)
    if not configName or configName == "" or configName == "Nenhuma" then return false end
    GarantirPastas()
    local elementsData = {}
    for flag, item in pairs(RegisteredElements) do
        local ok, val = pcall(item.get)
        if ok and val ~= nil then elementsData[flag] = val end
    end
    local okEncode, encoded = pcall(function()
        return HttpService:JSONEncode({ ["__version"] = 1, ["__elements"] = elementsData })
    end)
    if not okEncode or not encoded then return false end
    return pcall(function() writefile(CONFIG_FOLDER .. "/" .. configName .. ".json", encoded) end)
end

local function LoadConfig(configName)
    if not configName or configName == "" or configName == "Nenhuma" then
        Notificar("Aviso", "Selecione uma configuração válida.", 2)
        return false
    end
    local filePath = CONFIG_FOLDER .. "/" .. configName .. ".json"
    if not isfile or not isfile(filePath) then
        Notificar("Erro", "Arquivo não encontrado.", 2)
        return false
    end
    local okRead, content = pcall(readfile, filePath)
    if not okRead or not content then return false end
    local okDecode, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDecode or type(decoded) ~= "table" then return false end
    local elementsData = decoded["__elements"] or decoded
    if type(elementsData) ~= "table" then return false end
    if elementsData["ApexFree"] == true and elementsData["ApexPremium"] == true then
        elementsData["ApexPremium"] = false
    end
    for flag, value in pairs(elementsData) do
        if flag:sub(1, 2) ~= "__" then
            local item = RegisteredElements[flag]
            if item and type(item.set) == "function" then pcall(item.set, value) end
        end
    end
    Notificar("Carregado!", "Configuração '" .. configName .. "' aplicada.", 2)
    return true
end

