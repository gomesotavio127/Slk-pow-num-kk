    Inst("TextLabel", {
        Position = UDim2.new(0, SP.md, 0, descricao and 9 or 0),
        Size = UDim2.new(1, -64, 0, descricao and 16 or 40), BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = T.item, Text = texto, TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)
    if descricao then
        Inst("TextLabel", {
            Position = UDim2.new(0, SP.md, 0, 26), Size = UDim2.new(1, -64, 0, 15), BackgroundTransparency = 1,
            Font = Enum.Font.Gotham, TextSize = T.small, Text = descricao, TextColor3 = C.muted,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd
        }, row)
    end
    local track = Inst("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -SP.md, 0.5, 0),
        Size = UDim2.new(0, 38, 0, 20), BackgroundColor3 = C.surface, BorderSizePixel = 0
    }, row)
    Corner(track, 10)
    local knob = Inst("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = C.muted, BorderSizePixel = 0
    }, track)
    Corner(knob, 7)

    local function render(animar)
        local ti = animar and FAST or NONE
        Tween(knob, ti, { Position = UDim2.new(0, state and 21 or 3, 0.5, 0), BackgroundColor3 = state and C.accent or C.muted })
        Tween(track, ti, { BackgroundColor3 = state and C.accentSoft or C.surface })
    end

    local function setValue(v, aplicar)
        state = v and true or false
        render(true)
        if aplicar and aoMudar then aoMudar(state) end
    end

    row.MouseEnter:Connect(function()
        Tween(row, FAST, { BackgroundTransparency = 0 })
        Tween(st, FAST, { Color = C.border })
    end)
    row.MouseLeave:Connect(function()
        Tween(row, FAST, { BackgroundTransparency = 0.15 })
        Tween(st, FAST, { Color = C.borderSoft })
    end)
    row.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if aoMudar then aoMudar(state) end
    end)

    render(false)
    return { SetValue = setValue, Get = function() return state end }
end

