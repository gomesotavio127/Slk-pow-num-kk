-- SECAO 6: TELEPORTE (logica preservada)
local REMOTE_TELEPORT_NAME = "CapivaraTeleportRequest"
local teleportPendente = false

local function ObterRemoteTeleporte()
    local r = ReplicatedStorage:FindFirstChild(REMOTE_TELEPORT_NAME)
    if r and r:IsA("RemoteEvent") then return r end
    return nil
end

TeleportService.TeleportInitFailed:Connect(function(jogador, resultado, mensagem)
    if jogador ~= Player then return end
    teleportPendente = false
    Notificar("Falha no teleporte", tostring(mensagem) .. " (" .. tostring(resultado) .. ")", 4)
end)

local function SolicitarTeleporte(targetPlaceId)
    if not targetPlaceId or targetPlaceId == 0 then return end
    if game.PlaceId == targetPlaceId then
        Notificar("Você já está aqui", "Nenhum teleporte necessário.", 2)
        return
    end
    if teleportPendente then return end

    MostrarDialogo(
        "Jogo incompatível",
        string.format("Este script requer outro jogo.\nLocal atual: %d\nDestino: %d\n\nDeseja ser teleportado?", game.PlaceId, targetPlaceId),
        function()
            if game.PlaceId == targetPlaceId or teleportPendente then return end
            teleportPendente = true
            local remote = ObterRemoteTeleporte()
            if remote then
                remote:FireServer(targetPlaceId)
                task.delay(15, function()
                    if teleportPendente then
                        teleportPendente = false
                        Notificar("Sem resposta", "O servidor não confirmou o teleporte.", 4)
                    end
                end)
            else
                local ok, err = pcall(function() TeleportService:TeleportAsync(targetPlaceId, { Player }) end)
                if not ok then
                    teleportPendente = false
                    Notificar("Erro de Teleporte", tostring(err), 4)
                else
                    task.delay(15, function() teleportPendente = false end)
                end
            end
        end,
        function() teleportPendente = false end
    )
end

-- SECAO 7: COMPATIBILIDADE + EXECUCAO DE SCRIPTS
-- Le game.PlaceId E game.GameId no momento da chamada, normaliza tipos e aceita
-- qualquer id cadastrado (place OU universe). Nao inventa nem altera ids.
local function VerificarCompatibilidade(nomeJogo)
    local info = MapaJogos[nomeJogo]
    assert(info, "Jogo não encontrado no MapaJogos: " .. tostring(nomeJogo))
    assert(type(info.placeIds) == "table", "placeIds inválido: " .. tostring(nomeJogo))
    local currentPlaceId = tonumber(game.PlaceId)
    for _, id in ipairs(info.placeIds) do
        if tonumber(id) == currentPlaceId then
            return true, tonumber(info.defaultId) or tonumber(id)
        end
    end
    return false, tonumber(info.defaultId) or 0
end

local ultimasExecucoes = {}

local function ExecutarScript(dadosScript, nomeJogo)
    local now = tick()
    local key = (dadosScript.nome or "Script") .. "|" .. tostring(dadosScript.url)
    if ultimasExecucoes[key] and (now - ultimasExecucoes[key]) < 3 then return end
    ultimasExecucoes[key] = now

    local compativel, targetPlaceId = VerificarCompatibilidade(nomeJogo)
    if not compativel then
        SolicitarTeleporte(targetPlaceId)
        return
    end

    local thread = task.spawn(function()
        local codigo = dadosScript.codigo
        if not codigo and dadosScript.url then
            local okGet, res = pcall(function() return game:HttpGet(dadosScript.url) end)
            if okGet then codigo = res end
        end
        if codigo and codigo ~= "" then
            local fn, err = loadstring(codigo)
            if fn then
                local okExec, errExec = pcall(fn)
                if okExec then
                    Notificar("Sucesso", (dadosScript.nome or "Script") .. " executado!", 2)
                else
                    Notificar("Erro de Execução", tostring(errExec), 3)
                end
            else
                Notificar("Erro de Compilação", tostring(err), 3)
            end
        end
    end)
    RegistrarThread(thread)
end

