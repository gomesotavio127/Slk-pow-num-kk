    Estado.jogoSelecionado = jogo
    LateralNome.Text = jogo.nome
    LateralDesc.Text = jogo.desc or ""
    RenderScripts(jogo)
    PainelDetalhe.Position = UDim2.new(1, 0, 0, 0)
    Tween(PainelLista, EASE_IN, { Position = UDim2.new(-1, 0, 0, 0) })
    Tween(PainelDetalhe, EASE, { Position = UDim2.new(0, 0, 0, 0) })
end

MostrarListaJogos = function()
    Estado.jogoSelecionado = nil
    RenderListaJogos()
    PainelLista.Position = UDim2.new(0, 0, 0, 0)
    Tween(PainelDetalhe, EASE_IN, { Position = UDim2.new(1, 0, 0, 0) })
    Tween(PainelLista, EASE, { Position = UDim2.new(0, 0, 0, 0) })
end

